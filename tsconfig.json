{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "./**/*",
    "../global.css",
    "../src/lib/types.ts",
    "nativewind-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],
  "exclude": [
    "../nativewind-env.d.ts",
    "../src",
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
