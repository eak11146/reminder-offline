{
  "expo": {
    "name": "reminder-offline",
    "slug": "reminder-offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reminder-offline",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.evo008.reminderoffline",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to save QR code to your gallery",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save QR code to your gallery",
          "isAccessMediaLocationEnabled": false,
          "isAudioEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9c8e89a7-4dfb-4b34-a8ff-c8662c44426f"
      }
    }
  }
}